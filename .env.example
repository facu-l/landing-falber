# Plantilla de variables de entorno. Copiar a .env.local (que NO se commitea):
#   cp .env.example .env.local
# En Netlify se cargan en Site configuration → Environment variables.

# --- Supabase ---------------------------------------------------------------
# Local: valores de `npx supabase status` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).
# Nube: Supabase Dashboard → Project Settings → API Keys.
# La URL va sin path (https://<ref>.supabase.co, sin /rest/v1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Saltea RLS. Solo servidor: NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp de FALBER -----------------------------------------------------
# Número del botón "Completar pedido en WhatsApp" (wa.me). Es público: aparece en el link.
# Formato: 549 + área + número, solo dígitos, sin el 0 ni el 15.
NEXT_PUBLIC_WHATSAPP_NUMBER=5492355481449

# --- Cloudflare Turnstile ---------------------------------------------------
# Claves de PRUEBA de Cloudflare (widget invisible que siempre pasa):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Para probar el rechazo: secret 2x0000000000000000000000000000000AA.
# Producción: Cloudflare Dashboard → Turnstile → tu widget (modo invisible).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Dominios donde vale un token (decisión 87), separados por comas. Coincidencia exacta:
# un token resuelto en un Deploy Preview (deploy-preview-N--falber.netlify.app) no sirve
# en producción. A los previews los protege la visibilidad Private de Netlify, no esta lista.
# Con las claves de prueba no se mira (Cloudflare responde "example.com").
# Producción: falber.com.ar,falber.netlify.app
SITE_HOSTNAMES=localhost

# --- Analítica (opcionales) -------------------------------------------------
# Sin estas dos el sitio funciona igual, solo sin medición.
# GA4: analytics.google.com → Administrar → Propiedad → Flujos de datos → Web.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity: clarity.microsoft.com → New project (el id corto del snippet).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Anti-abuso -------------------------------------------------------------
# Secreto para hashear la IP (p_client_key = HMAC-SHA256(ip, secreto)). Nunca se guarda la IP en crudo.
# Mínimo 32 caracteres: el servidor rechaza uno más corto.
# Generar uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
